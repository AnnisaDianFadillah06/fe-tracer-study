# Salin ke .env.e2e (sudah di-gitignore) dan isi dengan kredensial akun uji
# KHUSUS -- bukan akun staf/alumni asli. Lihat e2e/README.md.

E2E_BASE_URL=https://smart-tracer.id

# Akun staf dedicated test account, role head_tracer (akses dashboard penuh)
E2E_HEAD_TRACER_EMAIL=
E2E_HEAD_TRACER_PASSWORD=

# Akun staf dedicated test account, role kaprodi (dipakai untuk pengujian RBAC)
E2E_KAPRODI_EMAIL=
E2E_KAPRODI_PASSWORD=

# Akun staf dedicated test account, role tracer_team (Admin) -- RBAC 6-role
E2E_TRACER_TEAM_EMAIL=
E2E_TRACER_TEAM_PASSWORD=

# Akun staf dedicated test account, role wadir (Pimpinan) -- RBAC 6-role
E2E_WADIR_EMAIL=
E2E_WADIR_PASSWORD=

# Akun staf dedicated test account, role kajur (Ketua Jurusan) -- RBAC 6-role
E2E_KAJUR_EMAIL=
E2E_KAJUR_PASSWORD=

# Akun staf dedicated test account, role dekan (multi-jurusan) -- RBAC 6-role
E2E_DEKAN_EMAIL=
E2E_DEKAN_PASSWORD=

# Akun alumni dedicated test account -- konsen BELUM diberikan (untuk TC-230)
E2E_ALUMNI_NIM=
E2E_ALUMNI_PASSWORD=

# Akun alumni dedicated test account KEDUA -- kuesioner sudah Finished (untuk TC-242)
E2E_ALUMNI_FINISHED_NIM=
E2E_ALUMNI_FINISHED_PASSWORD=

# Alamat REST API backend.
VITE_API_URL=http://localhost:8000/api

# --- Identitas institusi ---------------------------------------------------
# SmartTracer dipasang satu kali untuk satu perguruan tinggi. Nilai di bawah
# ini yang menentukan nama, kontak, dan alamat yang tampil di seluruh
# antarmuka. Biarkan kosong untuk memakai bawaan netral di
# src/config/institution.ts.
#
# Isian contoh di bawah memakai POLBAN karena data demo di repositori ini
# memang berasal dari sana. Ganti seluruhnya saat dipasang di PT lain.
VITE_INSTITUTION_NAME="Politeknik Negeri Bandung"
VITE_INSTITUTION_SHORT_NAME="POLBAN"
VITE_INSTITUTION_DOMAIN="polban.ac.id"
VITE_INSTITUTION_APP_DOMAIN="tracer-study.polban.ac.id"
VITE_INSTITUTION_EMAIL="tracerstudy@polban.ac.id"
VITE_INSTITUTION_PHONE="(022) 2013789"
VITE_INSTITUTION_ADDRESS="Jl. Gegerkalong Hilir, Bandung 40559"
VITE_INSTITUTION_UNIT="Unit Penjaminan Mutu"

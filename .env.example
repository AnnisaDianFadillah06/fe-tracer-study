# Alamat REST API backend.
VITE_API_URL=http://localhost:8000/api

# Link Metabase eksternal untuk halaman "Multidimensi Insight". Kosongkan
# untuk memakai bawaan https://analyst.smart-tracer.id.
VITE_METABASE_DASHBOARD_URL=https://analyst.smart-tracer.id

# --- Identitas institusi ---------------------------------------------------
# SmartTracer dipasang satu kali untuk satu perguruan tinggi. Nilai di bawah
# ini yang menentukan nama, kontak, dan alamat yang tampil di seluruh
# antarmuka. Biarkan kosong untuk memakai bawaan netral di
# src/config/institution.ts.
#
# Isian contoh di bawah memakai placeholder generik "Perguruan Tinggi".
# Ganti seluruhnya saat dipasang di PT tertentu.
VITE_INSTITUTION_NAME="Perguruan Tinggi"
VITE_INSTITUTION_SHORT_NAME="Perguruan Tinggi"
VITE_INSTITUTION_DOMAIN="perguruantinggi.ac.id"
VITE_INSTITUTION_APP_DOMAIN="tracer-study.perguruantinggi.ac.id"
VITE_INSTITUTION_EMAIL="tracerstudy@perguruantinggi.ac.id"
VITE_INSTITUTION_PHONE="(022) 2013789"
VITE_INSTITUTION_ADDRESS="Jl. Gegerkalong Hilir, Bandung 40559"
VITE_INSTITUTION_UNIT="Unit Penjaminan Mutu"
